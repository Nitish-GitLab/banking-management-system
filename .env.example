# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=india
DB_TABLE=customerShop

# Optional ------------------------------------------------------------
# Name of a column you have VERIFIED to be a unique customer identifier.
# Leave empty if you have not verified one (each row is then one "record").
CUSTOMER_ID_COLUMN=

# Currency symbol shown in KPI cards (the source data has no currency column).
CURRENCY_SYMBOL=₹

# Income band thresholds (Low < LOW_MAX <= Med < MED_MAX <= High)
INCOME_LOW_MAX=100000
INCOME_MED_MAX=300000

# Set to true for public demos: hides record-level data and CSV download.
DEMO_MODE=false
